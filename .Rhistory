library(shinythemes)
# 定义UI
ui <- fluidPage(
theme = shinytheme("united"),  # 使用 ShinyThemes 主题
navbarPage(
"TOmicsVis Cloud",
tabPanel(
"关于",
icon = icon("info-circle"),
fluidRow(
box(
title = "TOmicsVis Cloud",
width = 12,
solidHeader = TRUE,
status = "primary",
h3("功能简介"),
p(
"TOmicsVis Cloud 是一个基于 TOmicsVis 软件包的转录组可视化分析工具，能够提供丰富的图表和数据处理能力，帮助您快速完成以下任务："
),
br(),
h3("联系我们"),
p("如果您在使用过程中遇到任何问题或有任何建议，请通过以下方式联系我们："),
tags$p(tags$b("邮箱："), "your-email@example.com"),
tags$p(tags$b("微信："), "your-wechat-id"),
tags$p(tags$b("GitHub 仓库："),
tags$a("https://github.com/benben-miao/TOmicsVis",
href = "https://github.com/benben-miao/TOmicsVis",
target = "_blank")),
)
)
)
)
)
# 定义服务器端逻辑
server <- function(input, output) {
# 如果需要添加任何动态交互逻辑，可以在这里实现
}
# 启动 Shiny 应用
shinyApp(ui = ui, server = server)
runApp('main.R')
runApp('main.R')
