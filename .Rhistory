library(shiny)
# 定义UI
ui <- fluidPage(
# 设置主题和样式
theme = shinytheme("united"),  # 使用 ShinyThemes 主题
navbarPage(
"TOmicsVis Cloud",
tabPanel(
"关于",
icon = icon("info-circle"),
fluidRow(
box(
title = "TOmicsVis Cloud",
width = 12,
solidHeader = TRUE,
status = "primary",
h3("功能简介"),
p(
"TOmicsVis Cloud 是一个基于 TOmicsVis 软件包的转录组可视化分析工具，能够提供丰富的图表和数据处理能力，帮助您快速完成以下任务："
),
ul(
li("多种基本统计图表（Quantile Plot、Box Plot 等），让您直观掌握数据特征"),
li("生存分析图，为医学和生物研究提供有力支持"),
li("相关性热图，助力您理解数据背后的潜在联系"),
li("降维分析工具（PCA、t-SNE、UMAP 等），在高维数据中寻找关键模式和结构"),
li("基因趋势图、火山图、MA 图，满足多种研究场景的可视化需求"),
li("细胞和基因互作网络图，展示复杂的生物网络关系")
),
br(),
h3("技术与要求"),
p(
"TOmicsVis Cloud 充分利用 R 语言的强大功能和敏捷的 Web 技术，确保高效的数据处理和准确的可视化结果，以下是使用本平台的基本要求："
),
ul(
li("支持 CSV、TSV 等常见文件格式，方便您上传和处理数据"),
li("基于网页运行，兼容主流浏览器（Chrome、Firefox、Safari 等）"),
li("建议单次上传数据量合理，大量数据可分批操作或联系开发团队获取支持")
),
br(),
h3("联系我们"),
p("如果您在使用过程中遇到任何问题或有任何建议，请通过以下方式联系我们："),
p(b("邮箱："), "your-email@example.com"),
p(b("微信："), "your-wechat-id"),
p(b("GitHub 仓库："), a(
"https://github.com/benben-miao/TOmicsVis",
href = "https://github.com/benben-miao/TOmicsVis",
target = "_blank"
)),
p("我们期待您的来信，将竭诚为您服务！")
)
)
)
)
)
