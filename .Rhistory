),
tabPanel("关于",
tags$style(HTML("
body {
font-family: Arial, sans-serif;
margin: 20px;
padding: 0;
}
.about-container {
max-width: 800px;
margin: 0 auto;
}
h1 {
text-align: center;
color: #333333;
}
h3 {
color: #444444;
margin: 20px 0 10px;
}
p {
line-height: 1.6;
color: #666666;
}
ul {
list-style: disc;
margin-left: 20px;
color: #666666;
}
.contact-info {
margin-top: 30px;
padding: 20px;
background-color: #f5f5f5;
border-radius: 5px;
}
")),
div(class = "about-container",
h1("关于TOmicsVis Cloud"),
h3("功能简介"),
tags$p("TOmicsVis Cloud基于TOmicsVis软件包，是一个专注于转录组可视化分析和结果展示的云平台。凭借强大的数据处理能力和丰富的可视化工具，您可以轻松完成以下类型的分析和绘图操作："),
tags$ul(
tags$li("丰度分布图（Quantile Plot）、箱线图（Box Plot）、小提琴图（Violin Plot）等基本统计图表，帮助您快速掌握数据的整体特征和分布情况。"),
tags$li("生存分析图（Survival Plot），可直观呈现样本的生存状态和时间分布，为医学和生物研究提供有力支持。"),
tags$li("相关性热图（Corr Heatmap），能够揭示样本或变量之间的相关性关系，助力您理解数据背后的潜在联系。"),
tags$li("主成分分析（PCA）和t-SNE、UMAP等降维分析及可视化工具，帮助您在高维数据中寻找关键模式和结构。"),
tags$li("基因趋势图（Gene Trend）、火山图（Volcano Plot）、MA图等多种定制化图表，满足您对基因表达、差异分析等多种研究场景的可视化需求。"),
tags$li("细胞和基因互作网络图（Network Plot），以可视化方式展示复杂的生物网络关系，助力您探索生物系统中的复杂相互作用。")
),
h3("技术与要求"),
tags$p("TOmicsVis Cloud充分利用了R语言在统计分析和数据可视化方面的强大功能，同时结合敏捷的WEB技术，确保数据处理和显示的效率与准确性。以下是使用本平台的基本要求："),
tags$ul(
tags$li("支持的文件格式：平台接受常见格式的输入文件，包括CSV、TSV等，方便您上传和处理各类生物信息学数据。"),
tags$li("系统兼容性：该平台基于网页运行，兼容主流浏览器，如Chrome、Firefox、Safari等，为用户提供便捷的操作体验。"),
tags$li("数据量要求：为了保障数据处理的效率和稳定性，我们建议单次上传的数据量控制在合理范围内，若您有大量数据需要处理，建议分批操作或联系开发团队获取更多支持。")
),
h3("联系我们"),
div(class = "contact-info",
tags$p("如果您在使用TOmicsVis Cloud时遇到任何问题，或者有任何宝贵建议和反馈，欢迎与我们联系："),
tags$p(tags$b("邮箱："), "[您的邮箱]"),
tags$p(tags$b("微信："), "[您的微信]"),
tags$p(tags$b("GitHub仓库："),
tags$a(href = "https://github.com/benben-miao/TOmicsVis", "https://github.com/benben-miao/TOmicsVis")),
tags$p("我们期待您的来信，将竭诚为您服务！")
)
)
)
)
)
