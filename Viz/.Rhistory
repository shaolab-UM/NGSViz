getGenomeName <- function(db_file){
con <- RSQLite::dbConnect(RSQLite::SQLite(), dbname = db_file)
query_key <- "SELECT DISTINCT Genome FROM defaultTbl"
results <- dbGetQuery(con, query_key)
dbDisconnect(con)
return(results)
}
