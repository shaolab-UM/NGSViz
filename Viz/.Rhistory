myTheme <- function(plot_paras){
# theme
custom_theme <- theme_bw() +
theme(
text = element_text(family = "Arial", colour="black"),
# size and color of panel.border
panel.border = element_rect(size = plot_paras$border_size,
colour = plot_paras$border_color),
panel.grid = element_blank(),
axis.text.x = element_text(size = plot_paras$axis_text_x_size, face = "bold"),
axis.text.y = element_text(size = plot_paras$axis_text_y_size, face = "bold"),
axis.title=element_text(size = plot_paras$title_size, face = "bold"),
legend.text = element_text(size = 10, face = "bold"),
plot.title = element_text(size = plot_paras$title_size, hjust = 0.5, face = "bold"),
#legend.title=element_text(colour="white"), # remove the legend title
legend.key=element_rect(colour = "white")
)
return(custom_theme)
}
processRowOrder <- function(df_long){
# hc_df <- getHCluster(hc_df, cluster_num, hc_m, dist_m)
# order
sorted_df <- df_long %>%
group_by(Gene) %>%
mutate(mean_coverage = mean(Coverage)) %>% # 添加均值列，保留所有原始列
ungroup() %>% # 解除分组
arrange(mean_coverage) # 按均值降序排列
# arrange(desc(mean_value)) # 按均值降序排列
# 获取 sorted_df 中 Gene 的顺序
gene_order <- unique(sorted_df$Gene) # 按 sorted_df 的顺序提取唯一 Gene
sorted_df$Gene <- factor(sorted_df$Gene, levels = gene_order)
return(sorted_df)
# #
# hc_df$cat <- factor(hc_df$cat, levels = sorted_df$cat)
# r_order <- hc_df$gene
# count_num <- table(hc_df$cat)
# r_split <- factor(rep(names(count_num),count_num), levels = sorted_df$cat)
}
# to generate the axis label
getXAxisCoor <- function(running_paras){
interval_type <- running_paras$plot_paras$interval_type
num_middle_point <- running_paras$plot_paras$middle_point
num_flank_point <- running_paras$plot_paras$flank_point
flank_size <- running_paras$plot_paras$flank_size
num_datapoints <- running_paras$plot_paras$num_datapoints
region_labels <- running_paras$plot_paras$region_labels
# get x-axis label
axis_name <- c(paste0("-", flank_size), region_labels, flank_size)
# get x-axis position
if(interval_type == "broad_interval"){
axis_pos <- c(1, (num_flank_point+1),
(num_datapoints-num_flank_point), num_datapoints)
}else{
# point mode
axis_pos <- c(1, (num_flank_point+1), num_datapoints)
}
names(axis_pos) <- axis_name
return(axis_pos)
}
plotMain <- function(running_paras){
sample_df <- running_paras$sample_df
out_path <- running_paras$plot_paras$output_name
bg_col <- c("#Cb648b", "#679cd2")
ht_list <- list()
for (i in 1:nrow(sample_df)) {
sample_name <- running_paras$plot_paras$sample_list[i]
file_path <- sprintf("%s/%s__%s__%s", out_path, sample_df[i, 1],
sample_df[i, 2], sample_df[i, 3])
ht <- plotEnrichedHeatmap(file_path, running_paras, bg_col[i], sample_name)
ht_list[[i]] <- ht
}
}
bg_col <- "#Cb648b"
i <- 1
matrix2LongDf <- function(data_mat){
#
df_wide <- as.data.frame(data_mat)
# Step 2: Move the row names (gene names) of the data frame to a new column
df_wide <- df_wide |> rownames_to_column("Gene")
# Step 3: Use pivot_longer to convert the position column to long format
df_long <- df_wide |>
pivot_longer(
cols = -Gene,
names_to = "Position",
values_to = "Coverage"
)
df_long["XAsis"] <- sub("X", "", df_long$Position) |> as.numeric()
if(min(df_long$XAsis) == 0){
df_long$XAsis <- df_long$XAsis+1
}
return(df_long)
}
# Lack of split plot based on gene clustering or differential genes
coverageHeatmap <- function(file_path, running_paras, bg_col, sample_name, plot_paras){
data_mat <- read.csv(file_path, sep = ',', row.names = 1) %>% as.matrix()
# plot_paras
color_ramp <- colorRamp2(quantile(data_mat, c(0, 0.99)), c("grey95", bg_col))
# X-axis label and position
axis_pos <- getXAxisCoor(running_paras)
axis_name <- names(axis_pos)
# positon of vertical reference line
line_pos <- axis_pos[-c(1, length(axis_pos))]
# transform the matrix into the long data
df_long <- matrix2LongDf(data_mat)
# order the row of the heatmap based on the mean coverage
sorted_df <- processRowOrder(df_long)
# df_long["split"] <- "1"
pbom <-
ggplot(sorted_df) +
geom_raster(aes(x = XAsis, y = Gene, fill = Coverage)) + # plot heatmap
myTheme(plot_paras) +
# By splitting the variable
#facet_grid2(split ~ ., switch = "y", scales = "free_y", space = "free_y") +
xlab("") + ylab("") +
# add the axis-x label
scale_x_continuous(breaks = axis_pos, labels = axis_name) +
# Reference line
geom_vline(xintercept = line_pos, linetype = "dashed",
color = plot_paras$dash_color, size = plot_paras$dash_size) +
# Color fill using a continuous gradient palette
#scale_fill_continuous_sequential(palette = "Reds 3") +
scale_fill_gradientn(colors = color_ramp(seq(min(sorted_df$Coverage),
max(sorted_df$Coverage), length.out = 100)))+
# Remove the gap between the heatmap edge and the coordinate axis.
coord_cartesian(expand = 0) +
theme(
# Adjust the margin of the graph
plot.margin = margin(t = 0, r = .2, b = .2, l = .2, unit = "cm"),
# Remove Y-axis scale text
axis.text.y = element_blank(),
axis.ticks.y = element_blank(), # Remove the Y-axis scale lines
# Place the faceted titles externally
strip.placement = "outside",
# Adjust the spacing between horizontal facets
panel.spacing.x = unit(0.6, "cm"),
# axis.text.x = element_text(angle = 45,hjust = 1),
# Adjust the text direction of the left facet title
strip.text.y = element_text(angle = 180, vjust = 0.5),
# Remove faceted title background
strip.background = element_blank()
)
pbom
}
